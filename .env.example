# All optional. Command-line flags take precedence.
# Directory for the tool's own Chrome profile. Defaults to ~/.zoom-recording. Must be outside any git repository.
ZOOM_REC_HOME=/path/to/private/zoom-recording-home
# DevTools endpoint of the Chrome window the tool drives (loopback only).
ZOOM_REC_CDP=http://127.0.0.1:9391
# Profile directory that Chrome was started with, when attaching to a browser you started yourself.
ZOOM_REC_PROFILE_DIR=/path/to/chrome-profile
